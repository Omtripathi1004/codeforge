# ==============================================================================
# CodeForge Backend Configuration
# Nebius × NVIDIA Global AI Hackathon (Coding & Agentic Engineering)
# ==============================================================================

PROJECT_NAME="CodeForge Autonomous SWE Engine"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Host & Port
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Security & JWT Secrets (change for production)
SECRET_KEY="codeforge_development_secret_key_change_in_production_jwt_signature"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Connection (Default: Local durable SQLite; PostgreSQL in production)
DATABASE_URL="sqlite:///./data/codeforge_backend.db"

# ==============================================================================
# OpenRouter & Qwen3-Coder Configuration (PRIMARY AI MODEL PROVIDER)
# Model: qwen/qwen3-coder
# Base URL: https://openrouter.ai/api/v1
# ==============================================================================
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3-coder"
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.2

# ==============================================================================
# GitHub OAuth & Personal Access Token (OPTIONAL FOR LIVE GITHUB PRs)
# ==============================================================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_DEFAULT_TOKEN=""

# ==============================================================================
# Sandboxed Execution & Resource Constraints
# ==============================================================================
WORKSPACE_BASE_DIR="./data/workspaces"
EXECUTION_TIMEOUT_SECONDS=30
SANDBOX_CPU_LIMIT="2.0 vCPU"
SANDBOX_MEMORY_LIMIT="4096 MB"

# ==============================================================================
# Notification Providers (OPTIONAL)
# ==============================================================================
N8N_WEBHOOK_URL="https://n8n.internal.workflow/webhook/codeforge-mission-events"
N8N_ENABLED=True
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
